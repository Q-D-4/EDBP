#!/bin/bash

set -Eeuo pipefail
umask 077

if (( $# != 3 )); then
    printf 'Usage: %s PASSWORD_HASH_SOURCE PRESEED_TEMPLATE STAGED_PRESEED\n' "$0" >&2
    exit 2
fi

source_file=$1
template_file=$2
staged_file=$3

python3 - "${source_file}" "${template_file}" "${staged_file}" <<'PY'
import os
import pathlib
import re
import stat
import sys
import tempfile

source = pathlib.Path(sys.argv[1])
template = pathlib.Path(sys.argv[2])
destination = pathlib.Path(sys.argv[3])
token = "@@EDBP_LOCALADMIN_PASSWORD_HASH@@"


def abort(message: str) -> None:
    raise SystemExit(f"ERROR: {message}")


try:
    parent_stat = source.parent.stat()
except OSError as error:
    abort(f"cannot inspect password hash parent directory: {error}")
if not stat.S_ISDIR(parent_stat.st_mode):
    abort("password hash parent must be a directory")
if parent_stat.st_uid not in (0, os.getuid()):
    abort("password hash parent must be owned by root or the invoking build user")
if stat.S_IMODE(parent_stat.st_mode) & 0o022:
    abort("password hash parent must not be group/other writable")

descriptor = None
try:
    descriptor = os.open(
        source,
        os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW,
    )
    source_stat = os.fstat(descriptor)
    if not stat.S_ISREG(source_stat.st_mode):
        abort(f"password hash source must be a regular non-symlink file: {source}")
    if source_stat.st_uid != os.getuid():
        abort("password hash source must be owned by the invoking build user")
    if stat.S_IMODE(source_stat.st_mode) & 0o077:
        abort("password hash source permissions must be 0600 or stricter")
    if source_stat.st_size > 512:
        abort("password hash source exceeds the 512-byte safety limit")
    chunks = []
    total = 0
    while total <= 512:
        chunk = os.read(descriptor, 513 - total)
        if not chunk:
            break
        chunks.append(chunk)
        total += len(chunk)
    raw_hash = b"".join(chunks)
    if len(raw_hash) > 512:
        abort("password hash source exceeds the 512-byte safety limit")
except FileNotFoundError:
    abort(f"localadmin password hash file is missing: {source}")
except OSError as error:
    abort(f"cannot safely open password hash source: {error}")
finally:
    if descriptor is not None:
        os.close(descriptor)

if b"\x00" in raw_hash or b"\r" in raw_hash:
    abort("password hash source contains a forbidden NUL or carriage return")
if not raw_hash.endswith(b"\n") or raw_hash.count(b"\n") != 1:
    abort("password hash source must contain exactly one newline-terminated record")

try:
    password_hash = raw_hash[:-1].decode("ascii")
except UnicodeDecodeError:
    abort("password hash source must contain ASCII crypt(3) data only")

yescrypt = re.compile(
    r"^\$y\$[./0-9A-Za-z]+\$[./0-9A-Za-z]{1,86}\$[./0-9A-Za-z]{20,128}$"
)
sha512crypt = re.compile(
    r"^\$6\$(?:rounds=[1-9][0-9]{3,8}\$)?"
    r"[./0-9A-Za-z]{8,16}\$[./0-9A-Za-z]{86}$"
)
if not (yescrypt.fullmatch(password_hash) or sha512crypt.fullmatch(password_hash)):
    abort("only structurally valid yescrypt ($y$) or SHA-512-crypt ($6$) hashes are accepted")

try:
    template_stat = template.lstat()
    if not stat.S_ISREG(template_stat.st_mode):
        abort(f"preseed template must be a regular non-symlink file: {template}")
    template_text = template.read_text(encoding="utf-8")
except OSError as error:
    abort(f"cannot read preseed template: {error}")

if template_text.count(token) != 1:
    abort("preseed template must contain exactly one password-hash token")
if re.search(r"^[^#\n]*passwd/user-password(?:-again)?\s", template_text, re.MULTILINE):
    abort("preseed template contains a plaintext password question")

rendered = template_text.replace(token, password_hash)
destination.parent.mkdir(parents=True, exist_ok=True)

if destination.exists() or destination.is_symlink():
    destination_stat = destination.lstat()
    if not stat.S_ISREG(destination_stat.st_mode) or destination_stat.st_uid != os.getuid():
        abort(f"refusing to replace unexpected staged-preseed object: {destination}")

temporary_name = None
try:
    descriptor, temporary_name = tempfile.mkstemp(
        prefix=f".{destination.name}.",
        dir=destination.parent,
    )
    with os.fdopen(descriptor, "w", encoding="utf-8", newline="\n") as handle:
        os.fchmod(handle.fileno(), 0o600)
        handle.write(rendered)
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(temporary_name, destination)
    temporary_name = None
    directory_descriptor = os.open(destination.parent, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(directory_descriptor)
    finally:
        os.close(directory_descriptor)
finally:
    if temporary_name is not None:
        try:
            os.unlink(temporary_name)
        except FileNotFoundError:
            pass

print("Staged validated localadmin password hash without disclosing its value.")
PY
