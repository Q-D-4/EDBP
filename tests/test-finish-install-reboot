#!/bin/bash
# shellcheck disable=SC2016  # Reviewed shell source is intentionally literal.

set -Eeuo pipefail

project_root=$(cd -- "$(dirname -- "$0")/.." && pwd)
cd "${project_root}"

fail() {
    printf 'ERROR: finish-install reboot regression: %s\n' "$1" >&2
    exit 1
}

capture_status() {
    if "$@" >/dev/null 2>&1; then
        command_status=0
    else
        command_status=$?
    fi
}

policy=config/includes.installer/usr/lib/finish-install.d/94z-edbp-enable-normal-reboot
obsolete_handoff=config/includes.installer/usr/lib/finish-install.d/96edbp-live-installer-exit
preseed=config/includes.installer/preseed.cfg.in
reviewed_stock_sha256=e2400dba755604c27c362e56cbc10dad6fee461856bffe645906ca113ed40808
reviewed_replacement_sha256=e00cd9d4ba18354147cab8d59b37edce61db5011d213f8196f57b79e60112e7f
test_directory=$(mktemp -d)
trap 'rm -rf -- "${test_directory}"' EXIT

[[ -f ${policy} && ! -L ${policy} && -x ${policy} ]] \
    || fail 'normal-reboot policy is not an executable regular file'
[[ ! -e ${obsolete_handoff} && ! -L ${obsolete_handoff} ]] \
    || fail 'obsolete rc=11 Live handoff remains in production'

actual_order=$(printf '%s\n' \
    20final-message \
    94random-seed \
    "${policy##*/}" \
    95umount \
    97release-dhcp-lease \
    98exit-installer \
    99reboot \
    | LC_ALL=C sort | paste -sd, -)
expected_order=20final-message,94random-seed,94z-edbp-enable-normal-reboot,95umount,97release-dhcp-lease,98exit-installer,99reboot
[[ ${actual_order} == "${expected_order}" ]] \
    || fail 'production policy is not after upstream 94random-seed and before 95umount'

if awk '$1 == "d-i" && $2 == "finish-install/reboot_in_progress" { found = 1 } END { exit !found }' \
    "${preseed}"; then
    fail 'preseed still suppresses Debian final completion note'
fi
if grep -REn \
    'Installation complete|finish-install/reboot_in_progress|Template:.*finish-install' \
    config/includes.installer >/dev/null; then
    fail 'custom or suppressed completion UI remains in installer policy'
fi
if grep -REn \
    '(^|[[:space:];])(exit|return)[[:space:]]+11([[:space:];]|$)' \
    config/includes.installer/usr/lib/finish-install.d >/dev/null; then
    fail 'a production finish-install hook still requests rc=11 Live exit'
fi

grep -Fqx "reviewed_stock_sha256=${reviewed_stock_sha256}" "${policy}" \
    || fail 'policy does not pin live-installer 58 98exit-installer'
grep -Fqx "reviewed_replacement_sha256=${reviewed_replacement_sha256}" "${policy}" \
    || fail 'policy does not pin the reviewed no-op replacement'
grep -Fqx 'if [ -z "${LIVE_INSTALLER_MODE:-}" ]; then' "${policy}" \
    || fail 'policy is not limited to the nested Live installer'
grep -Fqx '    exit 10' "${policy}" \
    || fail 'unexpected upstream state does not stop before teardown'
grep -Fq 'temporary=$(mktemp "${stock_exit_hook}.edbp.XXXXXX")' "${policy}" \
    || fail 'replacement is not prepared beside upstream 98'
grep -Fq 'mv -f "${temporary}" "${stock_exit_hook}"' "${policy}" \
    || fail 'replacement is not installed with one atomic rename'
if grep -Fq '>"${stock_exit_hook}"' "${policy}"; then
    fail 'policy writes directly into upstream 98 instead of replacing atomically'
fi
if grep -Ev '^[[:space:]]*#' "${policy}" \
    | grep -En \
        '(^|[[:space:];&|])u?mount([[:space:]]|$)|/target|(^|[[:space:];&|])(stat|mountpoint|apt(-get)?|apt-install|anna-install|dpkg|udpkg|curl|wget|ip|ifconfig|nmcli|networkctl|dhclient|udhcpc|ping|reboot|poweroff|halt|shutdown|systemctl)([[:space:]]|$)' \
        >/dev/null; then
    fail 'normal-reboot policy performs unrelated target, mount, package, network, or reboot work'
fi

production_finish_files=$(find \
    config/includes.installer/usr/lib/finish-install.d \
    -mindepth 1 -maxdepth 1 -type f -printf '%f\n' | LC_ALL=C sort)
[[ ${production_finish_files} == 94z-edbp-enable-normal-reboot ]] \
    || fail 'an unrelated EDBP finish-install hook remains in production'

write_reviewed_stock() {
    local destination=$1

    printf '%s\n' \
        '#!/bin/sh -e' \
        '' \
        '[ -n "$LIVE_INSTALLER_MODE" ] && return 11' \
        >"${destination}"
    chmod 0755 "${destination}"
}

scenario_directory=
scenario_fixture=
scenario_runner=
prepare_scenario() {
    local name=$1

    scenario_directory=${test_directory}/${name}
    scenario_fixture=${scenario_directory}/98exit-installer
    scenario_runner=${scenario_directory}/${policy##*/}
    mkdir "${scenario_directory}"
    write_reviewed_stock "${scenario_fixture}"
    sed \
        "s|^stock_exit_hook=.*$|stock_exit_hook=${scenario_fixture}|" \
        "${policy}" >"${scenario_runner}"
    chmod 0755 "${scenario_runner}"
}

assert_stock_unchanged() {
    local path=$1
    local digest

    digest=$(sha256sum "${path}")
    [[ ${digest%% *} == "${reviewed_stock_sha256}" ]] \
        || fail 'failed or non-live preparation changed upstream 98 bytes'
}

assert_no_temporary() {
    local directory=$1

    if find "${directory}" -maxdepth 1 -name '98exit-installer.edbp.*' \
        -print -quit | grep -q .; then
        fail 'failed preparation left a temporary hook beside upstream 98'
    fi
}

prepare_scenario accepted
assert_stock_unchanged "${scenario_fixture}"
capture_status env LIVE_INSTALLER_MODE=1 "${scenario_runner}"
[[ ${command_status} -eq 0 ]] \
    || fail 'exact reviewed upstream 98 was not accepted in Live mode'
replacement_digest=$(sha256sum "${scenario_fixture}")
[[ ${replacement_digest%% *} == "${reviewed_replacement_sha256}" ]] \
    || fail 'accepted upstream 98 was not replaced with reviewed content'
replacement_listing=$(LC_ALL=C ls -ld "${scenario_fixture}")
[[ ${replacement_listing%% *} == -rwxr-xr-x ]] \
    || fail 'reviewed replacement mode is not exactly 0755'
capture_status env LIVE_INSTALLER_MODE=1 "${scenario_fixture}"
[[ ${command_status} -eq 0 ]] \
    || fail 'neutralized 98 did not continue the Live finish sequence'

prepare_scenario nonlive
capture_status env -u LIVE_INSTALLER_MODE "${scenario_runner}"
[[ ${command_status} -eq 0 ]] \
    || fail 'policy changed non-Live hook dispatch'
assert_stock_unchanged "${scenario_fixture}"
capture_status env -u LIVE_INSTALLER_MODE "${scenario_fixture}"
[[ ${command_status} -eq 1 ]] \
    || fail 'non-Live upstream 98 behavior was not preserved exactly'

prepare_scenario altered
printf '%s\n' '# altered' >>"${scenario_fixture}"
altered_before=$(sha256sum "${scenario_fixture}")
capture_status env LIVE_INSTALLER_MODE=1 "${scenario_runner}"
[[ ${command_status} -eq 10 ]] \
    || fail 'altered upstream 98 did not fail closed with rc=10'
altered_after=$(sha256sum "${scenario_fixture}")
[[ ${altered_after%% *} == "${altered_before%% *}" ]] \
    || fail 'altered upstream 98 was changed after validation failure'
assert_no_temporary "${scenario_directory}"

prepare_scenario wrong-mode
chmod 0775 "${scenario_fixture}"
capture_status env LIVE_INSTALLER_MODE=1 "${scenario_runner}"
[[ ${command_status} -eq 10 ]] \
    || fail 'wrong upstream 98 mode did not fail closed with rc=10'
assert_stock_unchanged "${scenario_fixture}"
wrong_mode_listing=$(LC_ALL=C ls -ld "${scenario_fixture}")
[[ ${wrong_mode_listing%% *} == -rwxrwxr-x ]] \
    || fail 'mode validation failure changed upstream 98 mode'

scenario_directory=${test_directory}/symlink
scenario_fixture=${scenario_directory}/98exit-installer
scenario_runner=${scenario_directory}/${policy##*/}
mkdir "${scenario_directory}"
write_reviewed_stock "${scenario_directory}/stock-target"
ln -s stock-target "${scenario_fixture}"
sed \
    "s|^stock_exit_hook=.*$|stock_exit_hook=${scenario_fixture}|" \
    "${policy}" >"${scenario_runner}"
chmod 0755 "${scenario_runner}"
capture_status env LIVE_INSTALLER_MODE=1 "${scenario_runner}"
[[ ${command_status} -eq 10 ]] \
    || fail 'symlinked upstream 98 did not fail closed with rc=10'
assert_stock_unchanged "${scenario_directory}/stock-target"
[[ -L ${scenario_fixture} ]] \
    || fail 'symlink validation failure replaced upstream 98'

make_failure_shim() {
    local directory=$1
    local command_name=$2

    mkdir "${directory}"
    printf '%s\n' '#!/bin/sh' 'exit 1' >"${directory}/${command_name}"
    chmod 0755 "${directory}/${command_name}"
}

for failing_command in mktemp chmod mv; do
    prepare_scenario "failure-${failing_command}"
    failure_shim_directory=${scenario_directory}/shim
    make_failure_shim "${failure_shim_directory}" "${failing_command}"
    capture_status env \
        PATH="${failure_shim_directory}:${PATH}" \
        LIVE_INSTALLER_MODE=1 \
        "${scenario_runner}"
    [[ ${command_status} -eq 10 ]] \
        || fail "${failing_command} failure did not preserve fail-closed rc=10"
    assert_stock_unchanged "${scenario_fixture}"
    assert_no_temporary "${scenario_directory}"
done

make_stub() {
    local path=$1
    local status=$2

    printf '%s\n' '#!/bin/sh' "exit ${status}" >"${path}"
    chmod 0755 "${path}"
}

sequence_log=${test_directory}/sequence
model_finish_install_rc_handling() {
    local live_mode=$1
    local modeled_hook
    local hook_status
    shift

    : >"${sequence_log}"
    for modeled_hook in "$@"; do
        printf '%s\n' "${modeled_hook##*/}" >>"${sequence_log}"
        if [[ ${live_mode} == __unset__ ]]; then
            capture_status env -u LIVE_INSTALLER_MODE "${modeled_hook}"
        else
            capture_status env LIVE_INSTALLER_MODE="${live_mode}" "${modeled_hook}"
        fi
        hook_status=${command_status}
        case ${hook_status} in
            10)
                return 10
                ;;
            11)
                return 11
                ;;
            *)
                ;;
        esac
    done
    return 0
}

prepare_model() {
    local name=$1

    model_directory=${test_directory}/${name}
    mkdir "${model_directory}"
    model_20=${model_directory}/20final-message
    model_94=${model_directory}/94random-seed
    model_policy=${model_directory}/${policy##*/}
    model_95=${model_directory}/95umount
    model_97=${model_directory}/97release-dhcp-lease
    model_98=${model_directory}/98exit-installer
    model_99=${model_directory}/99reboot
    make_stub "${model_20}" 0
    make_stub "${model_94}" 0
    make_stub "${model_95}" 0
    make_stub "${model_97}" 0
    make_stub "${model_99}" 0
    write_reviewed_stock "${model_98}"
    sed \
        "s|^stock_exit_hook=.*$|stock_exit_hook=${model_98}|" \
        "${policy}" >"${model_policy}"
    chmod 0755 "${model_policy}"
    model_hooks=(
        "${model_20}"
        "${model_94}"
        "${model_policy}"
        "${model_95}"
        "${model_97}"
        "${model_98}"
        "${model_99}"
    )
}

# This models finish-install 2.124's reviewed return-code dispatch. The stubs
# represent hook status only and are not presented as upstream binaries.
prepare_model model-live
capture_status model_finish_install_rc_handling 1 "${model_hooks[@]}"
[[ ${command_status} -eq 0 ]] \
    || fail 'modeled Live path did not continue through canonical 99reboot'
[[ $(paste -sd, "${sequence_log}") == "${expected_order}" ]] \
    || fail 'modeled Live path did not reach every reviewed finish hook'

prepare_model model-nonlive
capture_status model_finish_install_rc_handling __unset__ "${model_hooks[@]}"
[[ ${command_status} -eq 0 ]] \
    || fail 'modeled non-Live path did not continue through canonical 99reboot'
[[ $(paste -sd, "${sequence_log}") == "${expected_order}" ]] \
    || fail 'modeled non-Live path did not preserve normal hook continuation'

prepare_model model-failure
printf '%s\n' '# altered' >>"${model_98}"
capture_status model_finish_install_rc_handling 1 "${model_hooks[@]}"
[[ ${command_status} -eq 10 ]] \
    || fail 'modeled validation failure did not stop with rc=10 before teardown'
[[ $(paste -sd, "${sequence_log}") == \
    '20final-message,94random-seed,94z-edbp-enable-normal-reboot' ]] \
    || fail 'modeled validation failure reached 95umount or 99reboot'

obsolete_files=(
    config/includes.installer/usr/lib/finish-install.d/94edbp-finish-install-trace
    config/includes.installer/usr/lib/finish-install.d/94z-edbp-finish-install-prepare-98-trace
    config/includes.installer/usr/lib/finish-install.d/97edbp-finish-install-post95-trace
    config/includes.installer/usr/lib/edbp-finish-install-98-wrapper
    tests/98exit-installer.trixie.fixture
    tests/test-finish-install-diagnostic
    tests/test-finish-install-handoff
)
for obsolete_file in "${obsolete_files[@]}"; do
    [[ ! -e ${obsolete_file} && ! -L ${obsolete_file} ]] \
        || fail "obsolete finish-install artifact remains: ${obsolete_file}"
done

if grep -REn \
    'edbp-finish-install-(debug|post95)\.log|checkpoint=(94edbp-finish-install-trace|97edbp-finish-install-post95-trace|98exit-installer-return)|TEMPORARY finish-install|TEMPORARY DIAGNOSTIC' \
    config/includes.installer scripts >/dev/null; then
    fail 'temporary finish-install diagnostic text remains in production files'
fi

printf '%s\n' 'Finish-install normal reboot regression passed.'
