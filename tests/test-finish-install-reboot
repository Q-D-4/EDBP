#!/bin/bash
# shellcheck disable=SC2016  # Reviewed shell source is intentionally literal.

set -Eeuo pipefail

project_root=$(cd -- "$(dirname -- "$0")/.." && pwd)
cd "${project_root}"

fail() {
    printf 'ERROR: finish-install reboot regression: %s\n' "$1" >&2
    exit 1
}

capture_status() {
    if "$@" >/dev/null 2>&1; then
        command_status=0
    else
        command_status=$?
    fi
}

policy=config/includes.installer/usr/lib/finish-install.d/94z-edbp-enable-normal-reboot
obsolete_handoff=config/includes.installer/usr/lib/finish-install.d/96edbp-live-installer-exit
preseed=config/includes.installer/preseed.cfg.in
reviewed_stock_sha256=e2400dba755604c27c362e56cbc10dad6fee461856bffe645906ca113ed40808
reviewed_exit_replacement_sha256=e00cd9d4ba18354147cab8d59b37edce61db5011d213f8196f57b79e60112e7f
reviewed_reboot_wrapper_sha256=fcaa29de5e1b76947db266501d80ba70dee80cc598a28bae433a64aa2cb713d2
reviewed_busybox_banner='BusyBox v1.37.0 (Debian 1:1.37.0-6+b8) multi-call binary.'
test_directory=$(mktemp -d)
trap 'rm -rf -- "${test_directory}"' EXIT

[[ -f ${policy} && ! -L ${policy} && -x ${policy} ]] \
    || fail 'nested-installer compatibility policy is not an executable regular file'
[[ ! -e ${obsolete_handoff} && ! -L ${obsolete_handoff} ]] \
    || fail 'obsolete rc=11 Live handoff remains in production'

actual_order=$(printf '%s\n' \
    20final-message \
    94random-seed \
    "${policy##*/}" \
    95umount \
    97release-dhcp-lease \
    98exit-installer \
    99reboot \
    | LC_ALL=C sort | paste -sd, -)
expected_hook_order=20final-message,94random-seed,94z-edbp-enable-normal-reboot,95umount,97release-dhcp-lease,98exit-installer,99reboot
[[ ${actual_order} == "${expected_hook_order}" ]] \
    || fail 'production policy is not after upstream 94random-seed and before 95umount'

if awk '$1 == "d-i" && $2 == "finish-install/reboot_in_progress" { found = 1 } END { exit !found }' \
    "${preseed}"; then
    fail 'preseed still suppresses Debian final completion note'
fi
if grep -REn \
    'Installation complete|finish-install/reboot_in_progress|Template:.*finish-install' \
    config/includes.installer >/dev/null; then
    fail 'custom or suppressed completion UI remains in installer policy'
fi
if grep -REn \
    '(^|[[:space:];])(exit|return)[[:space:]]+11([[:space:];]|$)' \
    config/includes.installer/usr/lib/finish-install.d >/dev/null; then
    fail 'a production finish-install hook still requests rc=11 Live exit'
fi

grep -Fqx "reviewed_stock_sha256=${reviewed_stock_sha256}" "${policy}" \
    || fail 'policy does not pin live-installer 58 hook 98'
grep -Fqx \
    "reviewed_exit_replacement_sha256=${reviewed_exit_replacement_sha256}" \
    "${policy}" \
    || fail 'policy does not pin the reviewed no-op hook 98 replacement'
grep -Fqx \
    "reviewed_reboot_wrapper_sha256=${reviewed_reboot_wrapper_sha256}" \
    "${policy}" \
    || fail 'policy does not pin the reviewed final reboot wrapper'
grep -Fqx "reviewed_busybox_banner='${reviewed_busybox_banner}'" "${policy}" \
    || fail 'policy does not pin the observed Trixie BusyBox rebuild'
grep -Fqx 'systemd_pid=1' "${policy}" \
    || fail 'reboot compatibility is not limited to PID 1'
grep -Fqx 'systemd_reboot_signal=39' "${policy}" \
    || fail 'systemd normal-reboot signal is not pinned to reviewed amd64 value 39'
grep -Fqx 'if [ -z "${LIVE_INSTALLER_MODE:-}" ]; then' "${policy}" \
    || fail 'policy is not limited to the nested Live installer'
grep -Fqx '    exit 10' "${policy}" \
    || fail 'unexpected runtime state does not stop before teardown'
grep -Fqx "    'exec /bin/busybox kill -39 1' >\"\${reboot_replacement}\"; then" \
    "${policy}" \
    || fail 'reviewed wrapper does not request systemd normal reboot exactly'
[[ $(grep -Fc 'exec /bin/busybox kill -39 1' "${policy}") -eq 1 ]] \
    || fail 'reviewed normal-reboot request is duplicated in production policy'
grep -Fqx \
    "\"\${busybox_path}\" kill -l \"\${systemd_reboot_signal}\" >/dev/null 2>&1 \\" \
    "${policy}" \
    || fail 'policy does not harmlessly verify BusyBox numeric-signal parsing'
grep -Fq 'pid1_comm_path=/proc/${systemd_pid}/comm' "${policy}" \
    || fail 'policy does not verify the actual PID 1 identity through procfs'
grep -Fq 'if [ "${pid1_comm}" != systemd ]; then' "${policy}" \
    || fail 'policy does not require the outer systemd manager'
grep -Fq 'exit_backup=$(mktemp "${stock_exit_hook}.edbp-backup.XXXXXX")' \
    "${policy}" \
    || fail 'policy does not stage a verified rollback copy of stock hook 98'
grep -Fq 'cp "${stock_exit_hook}" "${exit_backup}"' "${policy}" \
    || fail 'policy does not copy stock hook 98 into its rollback object'
grep -Fq 'mv -f "${exit_replacement}" "${stock_exit_hook}"' "${policy}" \
    || fail 'hook 98 replacement is not committed atomically'
grep -Fq 'mv -f "${reboot_replacement}" "${reboot_path}"' "${policy}" \
    || fail 'reboot wrapper is not committed atomically'
grep -Fq 'mv -f "${exit_backup}" "${stock_exit_hook}"' "${policy}" \
    || fail 'partial commit cannot restore stock hook 98 atomically'
if grep -Fq '>"${stock_exit_hook}"' "${policy}" \
    || grep -Fq '>"${reboot_path}"' "${policy}"; then
    fail 'policy writes directly into an upstream path instead of renaming atomically'
fi
if grep -Ev '^[[:space:]]*#' "${policy}" \
    | grep -En \
        '(^|[[:space:];&|])u?mount([[:space:]]|$)|/target|(^|[[:space:];&|])(apt(-get)?|apt-install|anna-install|dpkg|udpkg|curl|wget|ip|ifconfig|nmcli|networkctl|dhclient|udhcpc|ping|poweroff|halt|shutdown|systemctl)([[:space:]]|$)|reboot[[:space:]]+-f' \
        >/dev/null; then
    fail 'policy performs unrelated target, mount, package, network, or forced reboot work'
fi
if grep -Ev '^[[:space:]]*#' "${policy}" \
    | grep -En \
        '(^|[;&|])[[:space:]]*(if[[:space:]]+)?(![[:space:]]+)?(/sbin/)?reboot([[:space:];&|]|$)' \
        >/dev/null; then
    fail 'pre-95 policy invokes reboot instead of preparing the later command'
fi

production_finish_files=$(find \
    config/includes.installer/usr/lib/finish-install.d \
    -mindepth 1 -maxdepth 1 -type f -printf '%f\n' | LC_ALL=C sort)
[[ ${production_finish_files} == 94z-edbp-enable-normal-reboot ]] \
    || fail 'an unrelated EDBP finish-install hook remains in production'

write_reviewed_stock() {
    local destination=$1

    printf '%s\n' \
        '#!/bin/sh -e' \
        '' \
        '[ -n "$LIVE_INSTALLER_MODE" ] && return 11' \
        >"${destination}"
    chmod 0755 "${destination}"
}

write_busybox_stub() {
    local destination=$1

    printf '%s\n' \
        '#!/bin/sh' \
        'case "$*" in' \
        '    "--help")' \
        "        printf '%s\\n' '${reviewed_busybox_banner}'" \
        '        exit 0' \
        '        ;;' \
        '    "--list")' \
        "        printf '%s\\n' kill reboot" \
        '        exit 0' \
        '        ;;' \
        '    "kill -l 39")' \
        '        exit 0' \
        '        ;;' \
        '    *)' \
        '        exit 1' \
        '        ;;' \
        'esac' \
        >"${destination}"
    chmod 0755 "${destination}"
}

scenario_directory=
scenario_exit=
scenario_busybox=
scenario_reboot=
scenario_pid1=
scenario_runner=
prepare_scenario() {
    local name=$1

    scenario_directory=${test_directory}/${name}
    scenario_exit=${scenario_directory}/98exit-installer
    scenario_busybox=${scenario_directory}/bin/busybox
    scenario_reboot=${scenario_directory}/sbin/reboot
    scenario_pid1=${scenario_directory}/proc-1-comm
    scenario_runner=${scenario_directory}/${policy##*/}
    mkdir -p "${scenario_directory}/bin" "${scenario_directory}/sbin"
    write_reviewed_stock "${scenario_exit}"
    write_busybox_stub "${scenario_busybox}"
    ln -s "${scenario_busybox}" "${scenario_reboot}"
    printf '%s\n' systemd >"${scenario_pid1}"
    sed \
        -e "s|^stock_exit_hook=.*$|stock_exit_hook=${scenario_exit}|" \
        -e "s|^reboot_path=.*$|reboot_path=${scenario_reboot}|" \
        -e "s|^busybox_path=.*$|busybox_path=${scenario_busybox}|" \
        -e "s|^pid1_comm_path=.*$|pid1_comm_path=${scenario_pid1}|" \
        "${policy}" >"${scenario_runner}"
    chmod 0755 "${scenario_runner}"
}

assert_stock_unchanged() {
    local path=$1
    local digest

    digest=$(sha256sum "${path}")
    [[ ${digest%% *} == "${reviewed_stock_sha256}" ]] \
        || fail 'failed or non-Live preparation changed stock hook 98 bytes'
}

assert_reboot_symlink_unchanged() {
    local path=$1
    local expected_target=$2

    [[ -L ${path} ]] \
        || fail 'failed or non-Live preparation replaced the stock reboot symlink'
    [[ $(readlink "${path}") == "${expected_target}" ]] \
        || fail 'failed or non-Live preparation changed the stock reboot target'
}

assert_no_temporary() {
    local directory=$1

    if find "${directory}" -name '*.edbp.*' -print -quit | grep -q .; then
        fail 'preparation left a temporary compatibility object behind'
    fi
}

assert_failed_scenario_unchanged() {
    local expected_reboot_target=$1

    [[ ${command_status} -eq 10 ]] \
        || fail 'invalid or failed preparation did not return fail-closed rc=10'
    assert_stock_unchanged "${scenario_exit}"
    assert_reboot_symlink_unchanged "${scenario_reboot}" "${expected_reboot_target}"
    assert_no_temporary "${scenario_directory}"
}

prepare_scenario accepted
kill_log=${scenario_directory}/kill.log
[[ ! -e ${kill_log} ]] \
    || fail 'test setup unexpectedly contains a reboot request'
capture_status env LIVE_INSTALLER_MODE=1 "${scenario_runner}"
[[ ${command_status} -eq 0 ]] \
    || fail 'exact reviewed Live environment was not accepted'
exit_digest=$(sha256sum "${scenario_exit}")
[[ ${exit_digest%% *} == "${reviewed_exit_replacement_sha256}" ]] \
    || fail 'accepted stock hook 98 was not replaced with reviewed no-op content'
exit_listing=$(LC_ALL=C ls -ld "${scenario_exit}")
[[ ${exit_listing%% *} == -rwxr-xr-x ]] \
    || fail 'reviewed hook 98 replacement mode is not exactly 0755'
[[ -f ${scenario_reboot} && ! -L ${scenario_reboot} ]] \
    || fail 'accepted stock reboot symlink was not replaced by a regular wrapper'
reboot_digest=$(sha256sum "${scenario_reboot}")
[[ ${reboot_digest%% *} == "${reviewed_reboot_wrapper_sha256}" ]] \
    || fail 'installed final reboot wrapper differs from reviewed content'
reboot_listing=$(LC_ALL=C ls -ld "${scenario_reboot}")
[[ ${reboot_listing%% *} == -rwxr-xr-x ]] \
    || fail 'reviewed final reboot wrapper mode is not exactly 0755'
[[ ! -e ${kill_log} ]] \
    || fail 'pre-95 policy executed the future reboot request'
capture_status env LIVE_INSTALLER_MODE=1 "${scenario_exit}"
[[ ${command_status} -eq 0 ]] \
    || fail 'neutralized hook 98 did not continue the Live finish sequence'
assert_no_temporary "${scenario_directory}"

# Never execute the installed production wrapper in this test: it names PID 1.
# Replace only its reviewed BusyBox path in a test copy, then prove exact argv and
# exec status propagation using a harmless logger stub.
wrapper_kill_stub=${scenario_directory}/wrapper-kill-stub
wrapper_safe_copy=${scenario_directory}/reviewed-wrapper-safe-test-copy
printf '%s\n' \
    '#!/bin/sh' \
    'printf "%s\\n" "$*" >"${EDBP_TEST_KILL_LOG}"' \
    'exit "${EDBP_TEST_KILL_STATUS}"' \
    >"${wrapper_kill_stub}"
chmod 0755 "${wrapper_kill_stub}"
sed "s|/bin/busybox|${wrapper_kill_stub}|" \
    "${scenario_reboot}" >"${wrapper_safe_copy}"
chmod 0755 "${wrapper_safe_copy}"
capture_status env \
    EDBP_TEST_KILL_LOG="${kill_log}" \
    EDBP_TEST_KILL_STATUS=0 \
    "${wrapper_safe_copy}"
[[ ${command_status} -eq 0 && $(<"${kill_log}") == 'kill -39 1' ]] \
    || fail 'reviewed wrapper did not invoke the stub with exact normal-reboot argv'
capture_status env \
    EDBP_TEST_KILL_LOG="${kill_log}" \
    EDBP_TEST_KILL_STATUS=7 \
    "${wrapper_safe_copy}"
[[ ${command_status} -eq 7 && $(<"${kill_log}") == 'kill -39 1' ]] \
    || fail 'reviewed exec wrapper did not preserve the stub kill exit status'

prepare_scenario nonlive
printf '%s\n' init >"${scenario_pid1}"
nonlive_target=${scenario_busybox}
capture_status env -u LIVE_INSTALLER_MODE "${scenario_runner}"
[[ ${command_status} -eq 0 ]] \
    || fail 'policy changed non-Live hook dispatch'
assert_stock_unchanged "${scenario_exit}"
assert_reboot_symlink_unchanged "${scenario_reboot}" "${nonlive_target}"
assert_no_temporary "${scenario_directory}"
capture_status env -u LIVE_INSTALLER_MODE "${scenario_exit}"
[[ ${command_status} -eq 1 ]] \
    || fail 'non-Live stock hook 98 behavior was not preserved exactly'

prepare_scenario altered-stock
altered_reboot_target=${scenario_busybox}
printf '%s\n' '# altered' >>"${scenario_exit}"
altered_stock_before=$(sha256sum "${scenario_exit}")
capture_status env LIVE_INSTALLER_MODE=1 "${scenario_runner}"
[[ ${command_status} -eq 10 ]] \
    || fail 'altered stock hook 98 did not fail closed with rc=10'
altered_stock_after=$(sha256sum "${scenario_exit}")
[[ ${altered_stock_after%% *} == "${altered_stock_before%% *}" ]] \
    || fail 'altered stock hook 98 changed after validation failure'
assert_reboot_symlink_unchanged "${scenario_reboot}" "${altered_reboot_target}"
assert_no_temporary "${scenario_directory}"

prepare_scenario wrong-stock-mode
wrong_stock_reboot_target=${scenario_busybox}
chmod 0775 "${scenario_exit}"
capture_status env LIVE_INSTALLER_MODE=1 "${scenario_runner}"
[[ ${command_status} -eq 10 ]] \
    || fail 'wrong stock hook 98 mode did not fail closed with rc=10'
assert_stock_unchanged "${scenario_exit}"
wrong_stock_listing=$(LC_ALL=C ls -ld "${scenario_exit}")
[[ ${wrong_stock_listing%% *} == -rwxrwxr-x ]] \
    || fail 'stock hook mode validation changed its original mode'
assert_reboot_symlink_unchanged "${scenario_reboot}" "${wrong_stock_reboot_target}"
assert_no_temporary "${scenario_directory}"

prepare_scenario wrong-reboot-target
rm "${scenario_reboot}"
ln -s "${scenario_directory}/unexpected-busybox" "${scenario_reboot}"
wrong_reboot_target=$(readlink "${scenario_reboot}")
capture_status env LIVE_INSTALLER_MODE=1 "${scenario_runner}"
assert_failed_scenario_unchanged "${wrong_reboot_target}"

prepare_scenario regular-reboot
rm "${scenario_reboot}"
printf '%s\n' '#!/bin/sh' 'exit 1' >"${scenario_reboot}"
chmod 0755 "${scenario_reboot}"
capture_status env LIVE_INSTALLER_MODE=1 "${scenario_runner}"
[[ ${command_status} -eq 10 ]] \
    || fail 'regular stock reboot path did not fail closed with rc=10'
assert_stock_unchanged "${scenario_exit}"
[[ -f ${scenario_reboot} && ! -L ${scenario_reboot} ]] \
    || fail 'reboot-state validation changed the unexpected regular file'
[[ $(<"${scenario_reboot}") == $'#!/bin/sh\nexit 1' ]] \
    || fail 'reboot-state validation changed unexpected reboot bytes'
assert_no_temporary "${scenario_directory}"

prepare_scenario wrong-busybox-banner
wrong_banner_reboot_target=${scenario_busybox}
sed -i 's/BusyBox v1\.37\.0/BusyBox v1.36.0/' "${scenario_busybox}"
capture_status env LIVE_INSTALLER_MODE=1 "${scenario_runner}"
assert_failed_scenario_unchanged "${wrong_banner_reboot_target}"

prepare_scenario unsupported-numeric-signal
numeric_signal_reboot_target=${scenario_busybox}
sed -i 's/"kill -l 39")/"kill -l 38")/' "${scenario_busybox}"
capture_status env LIVE_INSTALLER_MODE=1 "${scenario_runner}"
assert_failed_scenario_unchanged "${numeric_signal_reboot_target}"

prepare_scenario wrong-pid1
wrong_pid_reboot_target=${scenario_busybox}
printf '%s\n' init >"${scenario_pid1}"
capture_status env LIVE_INSTALLER_MODE=1 "${scenario_runner}"
assert_failed_scenario_unchanged "${wrong_pid_reboot_target}"

make_failure_shim() {
    local directory=$1
    local command_name=$2

    mkdir "${directory}"
    printf '%s\n' '#!/bin/sh' 'exit 1' >"${directory}/${command_name}"
    chmod 0755 "${directory}/${command_name}"
}

for failing_command in mktemp cp chmod mv; do
    prepare_scenario "failure-${failing_command}"
    failure_reboot_target=${scenario_busybox}
    failure_shim_directory=${scenario_directory}/shim
    make_failure_shim "${failure_shim_directory}" "${failing_command}"
    capture_status env \
        PATH="${failure_shim_directory}:${PATH}" \
        LIVE_INSTALLER_MODE=1 \
        "${scenario_runner}"
    assert_failed_scenario_unchanged "${failure_reboot_target}"
done

prepare_scenario write-failure
write_failure_reboot_target=${scenario_busybox}
write_failure_directory=${scenario_directory}/unwritable-object
mkdir "${write_failure_directory}"
write_failure_shim=${scenario_directory}/shim
mkdir "${write_failure_shim}"
printf '%s\n' \
    '#!/bin/sh' \
    "printf '%s\\n' '${write_failure_directory}'" \
    'exit 0' \
    >"${write_failure_shim}/mktemp"
chmod 0755 "${write_failure_shim}/mktemp"
capture_status env \
    PATH="${write_failure_shim}:${PATH}" \
    LIVE_INSTALLER_MODE=1 \
    "${scenario_runner}"
[[ ${command_status} -eq 10 ]] \
    || fail 'replacement write failure did not preserve fail-closed rc=10'
assert_stock_unchanged "${scenario_exit}"
assert_reboot_symlink_unchanged "${scenario_reboot}" "${write_failure_reboot_target}"

prepare_scenario digest-mismatch
digest_mismatch_reboot_target=${scenario_busybox}
sed -i \
    "s|^reviewed_reboot_wrapper_sha256=.*$|reviewed_reboot_wrapper_sha256=$(printf '0%.0s' {1..64})|" \
    "${scenario_runner}"
capture_status env LIVE_INSTALLER_MODE=1 "${scenario_runner}"
assert_failed_scenario_unchanged "${digest_mismatch_reboot_target}"

# Commit hook 98 on the first mv, fail the reboot-wrapper mv, then permit the
# third mv to restore the verified stock backup. This exercises the only
# partial-commit window without allowing teardown to continue.
prepare_scenario rollback
rollback_reboot_target=${scenario_busybox}
rollback_shim=${scenario_directory}/shim
rollback_counter=${scenario_directory}/mv-counter
real_mv=$(command -v mv)
mkdir "${rollback_shim}"
printf '%s\n' \
    '#!/bin/sh' \
    'count=0' \
    'if [ -f "${EDBP_TEST_MV_COUNTER}" ]; then' \
    '    IFS= read -r count <"${EDBP_TEST_MV_COUNTER}" || exit 1' \
    'fi' \
    'count=$((count + 1))' \
    'printf "%s\\n" "${count}" >"${EDBP_TEST_MV_COUNTER}" || exit 1' \
    'if [ "${count}" -eq 2 ]; then' \
    '    exit 1' \
    'fi' \
    'exec "${EDBP_TEST_REAL_MV}" "$@"' \
    >"${rollback_shim}/mv"
chmod 0755 "${rollback_shim}/mv"
capture_status env \
    PATH="${rollback_shim}:${PATH}" \
    EDBP_TEST_MV_COUNTER="${rollback_counter}" \
    EDBP_TEST_REAL_MV="${real_mv}" \
    LIVE_INSTALLER_MODE=1 \
    "${scenario_runner}"
[[ ${command_status} -eq 10 ]] \
    || fail 'second commit failure did not preserve fail-closed rc=10'
[[ $(<"${rollback_counter}") -eq 3 ]] \
    || fail 'partial commit did not perform exactly one rollback rename'
assert_stock_unchanged "${scenario_exit}"
assert_reboot_symlink_unchanged "${scenario_reboot}" "${rollback_reboot_target}"
assert_no_temporary "${scenario_directory}"

make_stub() {
    local path=$1
    local status=$2

    printf '%s\n' '#!/bin/sh' "exit ${status}" >"${path}"
    chmod 0755 "${path}"
}

sequence_log=${test_directory}/sequence
model_finish_install_rc_handling() {
    local live_mode=$1
    local modeled_hook
    local hook_status
    shift

    : >"${sequence_log}"
    for modeled_hook in "$@"; do
        printf '%s\n' "${modeled_hook##*/}" >>"${sequence_log}"
        if [[ ${live_mode} == __unset__ ]]; then
            capture_status env -u LIVE_INSTALLER_MODE "${modeled_hook}"
        else
            capture_status env LIVE_INSTALLER_MODE="${live_mode}" "${modeled_hook}"
        fi
        hook_status=${command_status}
        case ${hook_status} in
            10)
                return 10
                ;;
            11)
                return 11
                ;;
            *)
                ;;
        esac
    done
    return 0
}

prepare_model() {
    local name=$1

    model_directory=${test_directory}/${name}
    mkdir -p "${model_directory}/bin" "${model_directory}/sbin"
    model_20=${model_directory}/20final-message
    model_94=${model_directory}/94random-seed
    model_policy=${model_directory}/${policy##*/}
    model_95=${model_directory}/95umount
    model_97=${model_directory}/97release-dhcp-lease
    model_98=${model_directory}/98exit-installer
    model_99=${model_directory}/99reboot
    model_busybox=${model_directory}/bin/busybox
    model_reboot=${model_directory}/sbin/reboot
    model_pid1=${model_directory}/proc-1-comm
    make_stub "${model_20}" 0
    make_stub "${model_94}" 0
    make_stub "${model_95}" 0
    make_stub "${model_97}" 0
    make_stub "${model_99}" 0
    write_reviewed_stock "${model_98}"
    write_busybox_stub "${model_busybox}"
    ln -s "${model_busybox}" "${model_reboot}"
    printf '%s\n' systemd >"${model_pid1}"
    sed \
        -e "s|^stock_exit_hook=.*$|stock_exit_hook=${model_98}|" \
        -e "s|^reboot_path=.*$|reboot_path=${model_reboot}|" \
        -e "s|^busybox_path=.*$|busybox_path=${model_busybox}|" \
        -e "s|^pid1_comm_path=.*$|pid1_comm_path=${model_pid1}|" \
        "${policy}" >"${model_policy}"
    chmod 0755 "${model_policy}"
    model_hooks=(
        "${model_20}"
        "${model_94}"
        "${model_policy}"
        "${model_95}"
        "${model_97}"
        "${model_98}"
        "${model_99}"
    )
}

# This models finish-install 2.124's reviewed return-code dispatch and rootskel
# 1.138's reviewed rc=20 reboot selection. Hook stubs represent status/order;
# they are not presented as copies of the upstream binaries.
prepare_model model-live
capture_status model_finish_install_rc_handling 1 "${model_hooks[@]}"
[[ ${command_status} -eq 0 ]] \
    || fail 'modeled Live path did not continue through canonical 99reboot'
[[ $(paste -sd, "${sequence_log}") == "${expected_hook_order}" ]] \
    || fail 'modeled Live path did not reach every reviewed finish hook'
printf '%s\n' rootskel-exit >>"${sequence_log}"
model_safe_wrapper=${model_directory}/reviewed-wrapper-safe-test-copy
model_kill_stub=${model_directory}/model-kill-stub
printf '%s\n' \
    '#!/bin/sh' \
    'printf "%s\\n" "$*" >>"${EDBP_TEST_SEQUENCE_LOG}"' \
    'exit 0' \
    >"${model_kill_stub}"
chmod 0755 "${model_kill_stub}"
sed "s|/bin/busybox|${model_kill_stub}|" \
    "${model_reboot}" >"${model_safe_wrapper}"
chmod 0755 "${model_safe_wrapper}"
capture_status env EDBP_TEST_SEQUENCE_LOG="${sequence_log}" "${model_safe_wrapper}"
[[ ${command_status} -eq 0 ]] \
    || fail 'modeled rootskel reboot wrapper did not reach its harmless kill stub'
[[ $(tail -n 1 "${sequence_log}") == 'kill -39 1' ]] \
    || fail 'modeled host reboot request did not use reviewed signal and PID'
sed -i '$d' "${sequence_log}"
