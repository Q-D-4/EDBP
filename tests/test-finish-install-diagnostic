#!/bin/bash
# shellcheck disable=SC2016  # Stub commands expand in their child shell.

set -Eeuo pipefail

project_root=$(cd -- "$(dirname -- "$0")/.." && pwd)
cd "${project_root}"

fail() {
    printf 'ERROR: finish-install diagnostic regression: %s\n' "$1" >&2
    exit 1
}

checkpoint_94=config/includes.installer/usr/lib/finish-install.d/94edbp-finish-install-trace
prepare_98=config/includes.installer/usr/lib/finish-install.d/94z-edbp-finish-install-prepare-98-trace
post_unmount=config/includes.installer/usr/lib/finish-install.d/97edbp-finish-install-post95-trace
traced_wrapper=config/includes.installer/usr/lib/edbp-finish-install-98-wrapper
upstream_fixture=tests/98exit-installer.trixie.fixture
verify_tree=scripts/verify-tree
reviewed_exit_sha256=e2400dba755604c27c362e56cbc10dad6fee461856bffe645906ca113ed40808
reviewed_wrapper_sha256=71d3ca5a8ca47fb73fa0346eceeb883eea833f5c241997f26b7027b3036cf507
test_directory=$(mktemp -d)
trap 'rm -rf -- "${test_directory}"' EXIT

for temporary_diagnostic in \
    "${checkpoint_94}" "${prepare_98}" "${post_unmount}" "${traced_wrapper}"; do
    grep -Fq 'TEMPORARY DIAGNOSTIC' "${temporary_diagnostic}" \
        || fail "component is not marked temporary: ${temporary_diagnostic}"
done

actual_order=$(printf '%s\n' \
    "${checkpoint_94##*/}" \
    "${prepare_98##*/}" \
    95umount \
    "${post_unmount##*/}" \
    97release-dhcp-lease \
    98exit-installer | LC_ALL=C sort | paste -sd, -)
expected_order=94edbp-finish-install-trace,94z-edbp-finish-install-prepare-98-trace,95umount,97edbp-finish-install-post95-trace,97release-dhcp-lease,98exit-installer
[[ ${actual_order} == "${expected_order}" ]] \
    || fail 'temporary preparation hook is not deterministically before 95umount'

grep -Fq '/dev/edbp-finish-install-post95.log' "${post_unmount}" \
    || fail 'post-95 checkpoint does not default to the writable d-i devtmpfs'
grep -Fq '/dev/edbp-finish-install-post95.log' "${traced_wrapper}" \
    || fail 'traced 98 does not append to the writable d-i devtmpfs'
if grep -En '(^|[^[:alnum:]_])/(usr|var)(/|[^[:alnum:]_]|$)' \
    "${post_unmount}" >/dev/null; then
    fail 'post-95 checkpoint still accesses the read-only /usr or /var trees'
fi
if grep -En \
    '(^|[[:space:];&|])(cp|install|ln|mkdir|mv|rm|chmod|chown)([[:space:]]|$)' \
    "${post_unmount}" >/dev/null; then
    fail 'post-95 checkpoint performs a write or replacement operation'
fi
for no_mount_component in "${prepare_98}" "${post_unmount}"; do
    if grep -En '(^|[[:space:];&|])u?mount([[:space:]]|$)' \
        "${no_mount_component}" >/dev/null; then
        fail "diagnostic alters installer mount state: ${no_mount_component}"
    fi
done

[[ -f ${upstream_fixture} && ! -L ${upstream_fixture} ]] \
    || fail 'reviewed upstream fixture is not a regular non-symlink file'
[[ -x ${upstream_fixture} ]] \
    || fail 'reviewed upstream fixture is not executable in this checkout'
fixture_index_record=$(git ls-files --stage -- "${upstream_fixture}")
read -r fixture_index_mode _fixture_blob fixture_index_stage fixture_index_path \
    <<<"${fixture_index_record}"
[[ ${fixture_index_mode} == 100755 \
    && ${fixture_index_stage} == 0 \
    && ${fixture_index_path} == "${upstream_fixture}" ]] \
    || fail 'reviewed upstream fixture Git index mode is not exactly 100755'
[[ $(sha256sum "${upstream_fixture}" | awk '{print $1}') == "${reviewed_exit_sha256}" ]] \
    || fail 'reviewed upstream fixture differs from Trixie 98exit-installer'
grep -Fq 'git ls-files --stage -- "${finish_exit_fixture}"' "${verify_tree}" \
    || fail 'tree verifier does not use the Git index for fixture mode'
if grep -E 'stat .*finish_exit_fixture' "${verify_tree}" >/dev/null; then
    fail 'tree verifier still requires an exact host checkout mode for fixture'
fi
grep -Fqx 'reviewed_exit_mode=755' "${prepare_98}" \
    || fail 'runtime upstream 98 mode is not still pinned to exactly 0755'
grep -Fqx "reviewed_exit_sha256=${reviewed_exit_sha256}" "${prepare_98}" \
    || fail 'runtime upstream 98 content is not pinned'
grep -Fqx "reviewed_wrapper_sha256=${reviewed_wrapper_sha256}" "${prepare_98}" \
    || fail 'reviewed traced-wrapper content is not pinned'
[[ $(sha256sum "${traced_wrapper}" | awk '{print $1}') == "${reviewed_wrapper_sha256}" ]] \
    || fail 'traced-wrapper signature differs from the preparation hook'

syslog=${test_directory}/syslog
printf '%s\n' \
    'installer finish-install: info: Running /usr/lib/finish-install.d/07preseed' \
    'installer unrelated: fixture that must not be copied' \
    'installer main-menu: INFO: Menu item finish-install selected' \
    >"${syslog}"

trace=${test_directory}/edbp-finish-install-debug.log
EDBP_FINISH_TRACE_LOG=${trace} \
EDBP_FINISH_TRACE_SYSLOG=${syslog} \
LIVE_INSTALLER_MODE=1 \
    "${checkpoint_94}"

grep -Fqx 'checkpoint=94edbp-finish-install-trace' "${trace}" \
    || fail 'hook-94 checkpoint was not persisted'
grep -Fqx 'LIVE_INSTALLER_MODE=1' "${trace}" \
    || fail 'Live Installer mode was not persisted'
grep -Fqx 'pending_upstream_hooks=95umount,98exit-installer' "${trace}" \
    || fail 'known post-checkpoint lifecycle was not identified'
grep -Fq 'finish-install.d/07preseed' "${trace}" \
    || fail 'finish-install path was not copied from syslog'
grep -Fq 'main-menu' "${trace}" \
    || fail 'main-menu path was not copied from syslog'
if grep -Fq 'unrelated' "${trace}"; then
    fail 'diagnostic copied unrelated installer log content'
fi
[[ $(stat -c '%a' "${trace}") == 600 ]] \
    || fail 'persistent diagnostic is not mode 0600'

# Diagnostic failures are fail-open and may not alter finish-install semantics.
EDBP_FINISH_TRACE_LOG=/proc/edbp-finish-install-debug.log \
EDBP_FINISH_TRACE_SYSLOG=${syslog} \
    "${checkpoint_94}" 2>/dev/null

if grep -En \
    'finish-install\.postinst|\.edbp-original|exit "\$\{rc\}"' \
    "${checkpoint_94}" >/dev/null; then
    fail 'diagnostic wraps or replaces the active finish-install postinst'
fi

mountpoint_directory=${test_directory}/mountpoint-bin
mkdir -p "${mountpoint_directory}"
printf '%s\n' \
    '#!/bin/sh' \
    '[ "$1" = -q ] || exit 2' \
    'case $2 in' \
    '    /target|/target/boot|/target/boot/efi) exit 1 ;;' \
    '    /proc|/sys|/dev|/dev/pts|/tmp|/run) exit 0 ;;' \
    '    *) exit 2 ;;' \
    'esac' >"${mountpoint_directory}/mountpoint"
chmod 0755 "${mountpoint_directory}/mountpoint"

capture_status() {
    set +e
    "$@" >/dev/null 2>&1
    command_status=$?
    set -e
}

upstream=${test_directory}/98exit-installer
reset_upstream() {
    cp -- "${upstream_fixture}" "${upstream}"
    chmod 0755 "${upstream}"
}

reset_upstream
capture_status env -u LIVE_INSTALLER_MODE "${upstream}"
[[ ${command_status} -eq 1 ]] \
    || fail 'reviewed upstream non-live fixture does not return 1'
capture_status env LIVE_INSTALLER_MODE=1 "${upstream}"
[[ ${command_status} -eq 11 ]] \
    || fail 'reviewed upstream live fixture does not return 11'

# The exact upstream hook is accepted and the wrapper is installed by a
# same-directory atomic rename before hook 95.
reset_upstream
mv_stub_directory=${test_directory}/mv-bin
mkdir -p "${mv_stub_directory}"
printf '%s\n' \
    '#!/bin/sh' \
    'printf "%s\n" "$@" >"${EDBP_TEST_MV_LOG}"' \
    'exec "${EDBP_TEST_REAL_MV}" "$@"' \
    >"${mv_stub_directory}/mv"
chmod 0755 "${mv_stub_directory}/mv"
mv_log=${test_directory}/mv-arguments
capture_status env \
    PATH="${mv_stub_directory}:${PATH}" \
    EDBP_TEST_MV_LOG="${mv_log}" \
    EDBP_TEST_REAL_MV="$(command -v mv)" \
    EDBP_FINISH_EXIT_HOOK="${upstream}" \
    EDBP_FINISH_TRACED_WRAPPER="${traced_wrapper}" \
    "${prepare_98}"
[[ ${command_status} -eq 0 ]] \
    || fail 'pre-95 preparation changed installer status on success'
cmp -s -- "${upstream}" "${traced_wrapper}" \
    || fail 'exact reviewed upstream 98 was not replaced by traced wrapper'
[[ $(stat -c '%a' "${upstream}") == 755 ]] \
    || fail 'installed traced 98 does not preserve runtime mode 0755'
mapfile -t mv_arguments <"${mv_log}"
[[ ${#mv_arguments[@]} -eq 4 \
    && ${mv_arguments[0]} == -f \
    && ${mv_arguments[1]} == -- \
    && ${mv_arguments[2]} == "${upstream}.edbp."* \
    && ${mv_arguments[2]%/*} == "${upstream%/*}" \
    && ${mv_arguments[3]} == "${upstream}" ]] \
    || fail 'traced 98 installation is not a same-directory atomic rename'

post95_trace=${test_directory}/edbp-finish-install-post95.log
PATH="${mountpoint_directory}:${PATH}" \
EDBP_FINISH_POST95_TRACE_LOG=${post95_trace} \
LIVE_INSTALLER_MODE=1 \
    "${post_unmount}"

grep -Fqx 'checkpoint=97edbp-finish-install-post95-trace' "${post95_trace}" \
    || fail 'post-95 checkpoint was not recorded'
grep -Fqx 'LIVE_INSTALLER_MODE=1' "${post95_trace}" \
    || fail 'post-95 checkpoint lost Live Installer mode'
for target_mount in target target_boot target_boot_efi; do
    grep -Fqx "mount_${target_mount}=not-mounted" "${post95_trace}" \
        || fail "post-95 checkpoint did not record ${target_mount} unmounted"
done
for installer_mount in proc sys dev dev_pts tmp run; do
    grep -Fqx "mount_${installer_mount}=mounted" "${post95_trace}" \
        || fail "post-95 checkpoint did not record ${installer_mount} mounted"
done
if grep -Ev \
    '^(EDBP TEMPORARY finish-install diagnostic|checkpoint=97edbp-finish-install-post95-trace|LIVE_INSTALLER_MODE=1|mount_(target|target_boot|target_boot_efi)=not-mounted|mount_(proc|sys|dev|dev_pts|tmp|run)=mounted)$' \
    "${post95_trace}" >/dev/null; then
    fail 'post-95 checkpoint recorded data outside the reviewed allowlist'
fi

capture_status env \
    EDBP_FINISH_POST95_TRACE_LOG="${post95_trace}" \
    LIVE_INSTALLER_MODE=1 "${upstream}"
[[ ${command_status} -eq 11 ]] \
    || fail 'traced live 98 did not preserve rc=11'
grep -Fqx 'checkpoint=98exit-installer-return' "${post95_trace}" \
    || fail 'traced 98 return checkpoint was not recorded'
grep -Fqx '98exit-installer_rc=11' "${post95_trace}" \
    || fail 'actual live 98 rc was not recorded'

capture_status env -u LIVE_INSTALLER_MODE \
    EDBP_FINISH_POST95_TRACE_LOG="${post95_trace}" "${upstream}"
[[ ${command_status} -eq 1 ]] \
    || fail 'traced non-live 98 changed the upstream rc=1 behavior'
grep -Fqx '98exit-installer_rc=1' "${post95_trace}" \
    || fail 'actual non-live 98 rc was not recorded'

# Trace write failures must preserve both reviewed return paths.
capture_status env \
    EDBP_FINISH_POST95_TRACE_LOG=/proc/edbp-finish-install-post95.log \
    LIVE_INSTALLER_MODE=1 "${upstream}"
[[ ${command_status} -eq 11 ]] \
    || fail 'trace failure changed the live 98 return code'
capture_status env -u LIVE_INSTALLER_MODE \
    EDBP_FINISH_POST95_TRACE_LOG=/proc/edbp-finish-install-post95.log \
    "${upstream}"
[[ ${command_status} -eq 1 ]] \
    || fail 'trace failure changed the non-live 98 return code'

# Hook 97 itself remains fail-open when the writable trace cannot be appended.
capture_status env \
    EDBP_FINISH_POST95_TRACE_LOG=/proc/edbp-finish-install-post95.log \
    LIVE_INSTALLER_MODE=1 "${post_unmount}"
[[ ${command_status} -eq 0 ]] \
    || fail 'post-95 trace failure changed installer semantics'

# Altered upstream content is rejected and left byte-for-byte unchanged.
reset_upstream
printf '%s\n' '# altered' >>"${upstream}"
altered_before=$(sha256sum "${upstream}" | awk '{print $1}')
capture_status env \
    EDBP_FINISH_EXIT_HOOK="${upstream}" \
    EDBP_FINISH_TRACED_WRAPPER="${traced_wrapper}" \
    "${prepare_98}"
[[ ${command_status} -eq 0 ]] \
    || fail 'altered upstream validation failure changed installer status'
[[ $(sha256sum "${upstream}" | awk '{print $1}') == "${altered_before}" ]] \
    || fail 'altered upstream 98 was not left byte-for-byte unchanged'

# Exact runtime mode 0755 remains mandatory even though the tracked fixture
# verifier intentionally uses Git's executable-bit model.
reset_upstream
chmod 0775 "${upstream}"
wrong_mode_before=$(sha256sum "${upstream}" | awk '{print $1}')
capture_status env \
    EDBP_FINISH_EXIT_HOOK="${upstream}" \
    EDBP_FINISH_TRACED_WRAPPER="${traced_wrapper}" \
    "${prepare_98}"
[[ ${command_status} -eq 0 ]] \
    || fail 'wrong upstream mode changed installer status'
[[ $(stat -c '%a' "${upstream}") == 775 \
    && $(sha256sum "${upstream}" | awk '{print $1}') == "${wrong_mode_before}" ]] \
    || fail 'wrong-mode upstream 98 was modified instead of rejected'

# Altered traced-wrapper content is rejected before any upstream replacement.
reset_upstream
altered_wrapper=${test_directory}/altered-wrapper
cp -- "${traced_wrapper}" "${altered_wrapper}"
printf '%s\n' '# altered' >>"${altered_wrapper}"
chmod 0755 "${altered_wrapper}"
wrapper_reject_before=$(sha256sum "${upstream}" | awk '{print $1}')
capture_status env \
    EDBP_FINISH_EXIT_HOOK="${upstream}" \
    EDBP_FINISH_TRACED_WRAPPER="${altered_wrapper}" \
    "${prepare_98}"
[[ ${command_status} -eq 0 ]] \
    || fail 'altered wrapper validation failure changed installer status'
[[ $(sha256sum "${upstream}" | awk '{print $1}') == "${wrapper_reject_before}" ]] \
    || fail 'altered traced wrapper caused upstream 98 replacement'

# Every fallible preparation step is fail-open and operates only on a temporary
# sibling, so the original upstream file remains untouched.
for failed_command in mktemp cp chmod mv; do
    reset_upstream
    failure_before=$(sha256sum "${upstream}" | awk '{print $1}')
    failure_mode_before=$(stat -c '%a' "${upstream}")
    failure_bin=${test_directory}/fail-${failed_command}
    mkdir -p "${failure_bin}"
    printf '%s\n' '#!/bin/sh' 'exit 1' >"${failure_bin}/${failed_command}"
    chmod 0755 "${failure_bin}/${failed_command}"
    capture_status env \
        PATH="${failure_bin}:${PATH}" \
        EDBP_FINISH_EXIT_HOOK="${upstream}" \
        EDBP_FINISH_TRACED_WRAPPER="${traced_wrapper}" \
        "${prepare_98}"
    [[ ${command_status} -eq 0 ]] \
        || fail "${failed_command} failure changed installer status"
    [[ $(sha256sum "${upstream}" | awk '{print $1}') == "${failure_before}" \
        && $(stat -c '%a' "${upstream}") == "${failure_mode_before}" ]] \
        || fail "${failed_command} failure modified upstream 98"
    if find "${test_directory}" -maxdepth 1 \
        -name '98exit-installer.edbp.*' -print -quit | grep -q .; then
        fail "${failed_command} failure left a preparation temporary file"
    fi
done

printf '%s\n' 'Finish-install diagnostic regression passed.'
