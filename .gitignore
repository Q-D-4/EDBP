# Generated live-build state (regenerated by auto/config)
config/binary
config/bootstrap
config/chroot
config/common
config/source

# Files/symlinks materialized by lb config from the installed live-build release
config/hooks/normal/
config/hooks/live/0010-disable-kexec-tools.hook.chroot
config/hooks/live/0050-disable-sysvinit-tmpfs.hook.chroot
config/package-lists/live.list.chroot

# ISO Artifacts & Logs
*.iso
*.sha256
*.contents
*.packages
*.zsync
binary.modified_timestamps
*.log
build.log
SHA256SUMS
edbp-*.manifest.json

# Secret Keys & Credentials (CRITICAL)
secrets/
config/includes.installer/localadmin_authorized_keys
*.pem
*.key
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*

# OS generated files
.DS_Store
Thumbs.db
