#!/bin/sh

set -eu

# brave-keyring is a hard dependency of brave-origin. During package install,
# only the build-time brave-browser.list source exists, so its postinst creates
# a globally trusted compatibility symlink. The final image uses the vendor's
# recognized brave-browser-release.list name, but that source is installed only
# during live-build's binary pass. Remove the initial symlink, while failing
# closed if the vendor changes it into an unexpected object. Later keyring
# upgrades will see the recognized final source and keep global trust removed.
legacy_trust=/etc/apt/trusted.gpg.d/brave-browser-release.gpg
expected_target=/usr/share/keyrings/brave-browser-archive-keyring.gpg

if [ -L "${legacy_trust}" ]; then
    actual_target=$(readlink "${legacy_trust}")
    if [ "${actual_target}" != "${expected_target}" ]; then
        printf '%s\n' \
            "ERROR: unexpected Brave trust symlink target: ${actual_target}" >&2
        exit 1
    fi
    rm -f -- "${legacy_trust}"
elif [ -e "${legacy_trust}" ]; then
    printf '%s\n' \
        "ERROR: refusing to remove unexpected Brave global trust object" >&2
    exit 1
fi

# Brave Origin 1.93.x currently creates a second Deb822 source that targets
# Google's Chrome repository and signs it with /usr/share/keyrings/brave-origin.gpg.
# EDBP installs Origin from the reviewed Brave repository, so retaining that
# additional source would expand APT trust and package ownership beyond the
# approved boundary. Accept and remove only the exact vendor-generated shape;
# abort if the object has drifted or contains administrator content.
origin_source=/etc/apt/sources.list.d/brave-origin.sources
origin_key=/usr/share/keyrings/brave-origin.gpg

if [ -f "${origin_source}" ] && [ ! -L "${origin_source}" ]; then
    grep -Fqx 'Types: deb' "${origin_source}" \
        && grep -Fqx 'URIs: https://dl.google.com/linux/chrome-stable/deb/' "${origin_source}" \
        && grep -Fqx 'Suites: stable' "${origin_source}" \
        && grep -Fqx 'Components: main' "${origin_source}" \
        && grep -Fqx 'Architectures: amd64' "${origin_source}" \
        && grep -Fqx 'Signed-By: /usr/share/keyrings/brave-origin.gpg' "${origin_source}" \
        || { printf '%s\n' 'ERROR: unexpected Brave Origin APT source' >&2; exit 1; }
    rm -f -- "${origin_source}"
elif [ -e "${origin_source}" ] || [ -L "${origin_source}" ]; then
    printf '%s\n' 'ERROR: refusing to remove unexpected Brave Origin source object' >&2
    exit 1
fi

if [ -f "${origin_key}" ] && [ ! -L "${origin_key}" ]; then
    rm -f -- "${origin_key}"
elif [ -e "${origin_key}" ] || [ -L "${origin_key}" ]; then
    printf '%s\n' 'ERROR: refusing to remove unexpected Brave Origin key object' >&2
    exit 1
fi
