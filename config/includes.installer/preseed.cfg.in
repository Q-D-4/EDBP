### EDBP Debian Installer partial preseed template
### scripts/stage-localadmin-password renders this file as /preseed.cfg.

# Apply only the reviewed defaults below. Unseeded partitioning questions stay
# interactive. The password token is replaced atomically at build time.
d-i auto-install/cloak_initrd_preseed boolean true

### Locale, keyboard, and clock
d-i debian-installer/language string en
d-i debian-installer/country string US
d-i debian-installer/locale string en_US.UTF-8
d-i localechooser/supported-locales multiselect en_US.UTF-8, ar_SY.UTF-8
d-i keyboard-configuration/xkb-keymap select us
d-i clock-setup/utc boolean true
d-i clock-setup/ntp boolean false
d-i time/zone string Asia/Damascus

### Network defaults
# DHCP/manual-network failure handling remains interactive. The hostname is a
# temporary installer value; EDBP OOBE replaces it on first installed boot.
d-i netcfg/choose_interface select auto
d-i netcfg/get_hostname string edbp-unconfigured
d-i netcfg/get_domain string unassigned-domain
d-i netcfg/wireless_wep string

### Identity
# The token below MUST occur exactly once and MUST never reach an ISO. The
# renderer accepts only a mode-0600, non-symlink yescrypt or SHA-512-crypt
# source file and writes the generated preseed with mode 0600.
d-i passwd/root-login boolean false
d-i passwd/make-user boolean true
d-i passwd/user-fullname string Local Administrator
d-i passwd/username string localadmin
d-i passwd/user-password-crypted password @@EDBP_LOCALADMIN_PASSWORD_HASH@@
d-i passwd/user-default-groups string sudo
d-i user-setup/allow-password-weak boolean false

### Package source policy
# The installation must succeed from the ISO without external APT traffic.
d-i apt-setup/use_mirror boolean false

### Partitioning safety and UEFI
# Only the preferred label is seeded. Deliberately absent:
#   partman-auto/disk
#   partman-auto/method
#   partman/choose_partition
#   partman/confirm
#   partman/confirm_nooverwrite
# Their absence preserves disk selection, recipe selection, and the final
# destructive confirmation as interactive installer steps.
d-i partman-partitioning/choose_label select gpt
d-i partman-partitioning/default_label string gpt
d-i partman/early_command string if [ ! -d /sys/firmware/efi ]; then logger -t edbp-installer "UEFI firmware interface is absent; refusing installation"; exit 1; fi

### Boot loader
d-i grub-installer/only_debian boolean true
d-i grub-installer/with_other_os boolean false

### Target finalization
d-i preseed/late_command string /bin/sh /edbp-late-command
d-i finish-install/reboot_in_progress note
