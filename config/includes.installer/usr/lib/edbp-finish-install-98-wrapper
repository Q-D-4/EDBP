#!/bin/sh

# TEMPORARY DIAGNOSTIC: semantically equivalent traced replacement for the
# reviewed Trixie live-installer 58 hook. Diagnostic write failures must never
# alter its live rc=11 or non-live rc=1 behavior.

trace=${EDBP_FINISH_POST95_TRACE_LOG:-/dev/edbp-finish-install-post95.log}

# record_exit is invoked indirectly by the trap below; ShellCheck cannot model
# that callback path.
# shellcheck disable=SC2317
record_exit() {
    rc=$?
    trap - EXIT
    {
        printf '%s\n' \
            'EDBP TEMPORARY finish-install diagnostic' \
            'checkpoint=98exit-installer-return' \
            "LIVE_INSTALLER_MODE=${LIVE_INSTALLER_MODE:-unset}" \
            "98exit-installer_rc=${rc}"
    } >>"${trace}" 2>/dev/null || true
    exit "${rc}"
}

trap record_exit EXIT

if [ -n "${LIVE_INSTALLER_MODE:-}" ]; then
    exit 11
fi
exit 1
