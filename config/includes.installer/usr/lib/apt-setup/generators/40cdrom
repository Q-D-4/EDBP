#!/bin/sh

set -eu

# EDBP uses Debian Live Installer: the complete reviewed SquashFS is copied to
# /target.  The hybrid ISO is intentionally not a Debian apt-cdrom repository,
# so the stock generator would run apt-cdrom against an incompatible medium and
# display a fatal-looking error despite no package installation being needed.
# Keep the apt-setup generator contract by returning an empty output fragment.
[ "$#" -eq 1 ]
: > "$1"
