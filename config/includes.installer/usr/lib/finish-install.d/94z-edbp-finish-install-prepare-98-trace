#!/bin/sh

# TEMPORARY DIAGNOSTIC: remove after the generic finish-install failure is
# identified. This hook installs the reviewed traced 98exit-installer before
# upstream 95umount makes the d-i root filesystem read-only. Any preparation
# failure leaves the upstream hook untouched and must not fail the installer.

set -u

exit_hook=${EDBP_FINISH_EXIT_HOOK:-/usr/lib/finish-install.d/98exit-installer}
traced_wrapper=${EDBP_FINISH_TRACED_WRAPPER:-/usr/lib/edbp-finish-install-98-wrapper}
reviewed_exit_mode=755
reviewed_exit_sha256=e2400dba755604c27c362e56cbc10dad6fee461856bffe645906ca113ed40808
reviewed_wrapper_sha256=71d3ca5a8ca47fb73fa0346eceeb883eea833f5c241997f26b7027b3036cf507
temporary=''

# cleanup is invoked indirectly by the trap below; ShellCheck cannot model
# that callback path.
# shellcheck disable=SC2317
cleanup() {
    [ -z "${temporary}" ] || rm -f -- "${temporary}" 2>/dev/null || true
}

trap cleanup EXIT

if [ ! -f "${exit_hook}" ] || [ -L "${exit_hook}" ]; then
    exit 0
fi
exit_mode=$(stat -c '%a' "${exit_hook}" 2>/dev/null) || exit_mode=''
if [ "${exit_mode}" != "${reviewed_exit_mode}" ]; then
    exit 0
fi
exit_signature_record=$(sha256sum "${exit_hook}" 2>/dev/null) \
    || exit_signature_record=''
exit_signature=${exit_signature_record%% *}
if [ "${exit_signature}" != "${reviewed_exit_sha256}" ]; then
    exit 0
fi

if [ ! -f "${traced_wrapper}" ] \
    || [ -L "${traced_wrapper}" ] \
    || [ ! -x "${traced_wrapper}" ]; then
    exit 0
fi
wrapper_signature_record=$(sha256sum "${traced_wrapper}" 2>/dev/null) \
    || wrapper_signature_record=''
wrapper_signature=${wrapper_signature_record%% *}
if [ "${wrapper_signature}" != "${reviewed_wrapper_sha256}" ]; then
    exit 0
fi

temporary=$(mktemp "${exit_hook}.edbp.XXXXXX" 2>/dev/null) || exit 0
if ! cp -- "${traced_wrapper}" "${temporary}" 2>/dev/null \
    || ! chmod "${reviewed_exit_mode}" "${temporary}" 2>/dev/null \
    || ! mv -f -- "${temporary}" "${exit_hook}" 2>/dev/null; then
    exit 0
fi
temporary=''

exit 0
