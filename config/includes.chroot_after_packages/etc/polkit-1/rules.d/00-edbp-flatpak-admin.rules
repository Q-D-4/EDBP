// Flatpak system-helper mutations are performed through password-required
// sudo by administrators. Do not inherit the vendor's active-user update
// allowance. This rule does not govern per-user installs or sandbox overrides.
polkit.addRule(function(action, subject) {
    if (action.id.indexOf("org.freedesktop.Flatpak.") === 0 &&
        subject.user !== "root") {
        return polkit.Result.NO;
    }
});
